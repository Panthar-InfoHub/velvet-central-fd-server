PORT=4000
SECRET_API_KEY=your_api_key_here

# Blostem provider
BLOSTEM_URL=https://blostem.example.com
BLOSTEM_MASTER_URL=https://blostem-master.example.com
BLOSTEM_USERNAME=your_blostem_username
BLOSTEM_PASSWORD=your_blostem_password
BLOSTEM_DASH_PASSWORD=your_blostem_dash_password
BLOSTEM_ENCRYPTION_KEY=your_encryption_key
BLOSTEM_ENCRYPTION_SALT=your_encryption_salt

# Velvet callbacks
VELVET_WEBHOOK_VALIDATE_URL=http://localhost:3000/api/v1/fd/webhook/validate
VELVET_WEBHOOK_CALLBACK_URL=http://localhost:3000
VELVET_API_KEY=your_velvet_internal_api_key

ENVIRONMENT=dev
